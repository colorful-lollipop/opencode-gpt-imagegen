{
  "name": "@makcimbx/opencode-gpt-imagegen",
  "version": "0.3.1",
  "description": "OpenCode plugin and Claude Code MCP server for image generation through Codex OAuth or OmniRoute fallback, with reference images and safe PNG output.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gpt-imagegen-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && bun build ./src/mcp.ts --outdir ./dist --target node --format esm",
    "test": "bun test tests/unit",
    "test:e2e_subscription": "OPENCODE_MODEL=openai/gpt-6.1-sol bun test tests/e2e/subscription.test.ts",
    "test:e2e_omniroute": "GPT_IMAGEGEN_AUTH_PROVIDER=omniroute bun test tests/e2e/omniroute.test.ts",
    "version": "bun scripts/sync-plugin-version.ts && git add .claude-plugin/plugin.json",
    "prepublishOnly": "bun run build",
    "release:patch": "bun scripts/prepare-release.ts patch",
    "release:minor": "bun scripts/prepare-release.ts minor",
    "release:major": "bun scripts/prepare-release.ts major"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "openai",
    "gpt-image-2",
    "gpt-image",
    "image-generation",
    "image-editing",
    "text-to-image",
    "chatgpt",
    "chatgpt-images",
    "chatgpt-oauth",
    "codex",
    "omniroute",
    "plugin"
  ],
  "author": "Yuji Hatakeyama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makcimbx/opencode-gpt-imagegen.git"
  },
  "homepage": "https://github.com/makcimbx/opencode-gpt-imagegen#readme",
  "bugs": {
    "url": "https://github.com/makcimbx/opencode-gpt-imagegen/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/server": "^2.2.0",
    "@opencode-ai/plugin": "^1.18.33",
    "@opencode/plugin": "^2.0.26",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.1",
    "file-type": "^22.1.1",
    "xdg-basedir": "^5.1.0"
  }
}
